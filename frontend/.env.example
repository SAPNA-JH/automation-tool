# Copy to .env.local for local dev; set these in Vercel → Project → Environment Variables.

# Backend API base URL (no trailing slash).
# Local dev: leave empty and use the Vite proxy, OR set http://localhost:8000
# Production (Vercel): your Render backend URL, e.g. https://glitch-studio-api.onrender.com
VITE_API_URL=

# Google OAuth Web client ID (same client ID as the backend's GOOGLE_CLIENT_ID).
# Leave empty to use the local dev-login instead.
VITE_GOOGLE_CLIENT_ID=

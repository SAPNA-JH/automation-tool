# Backend environment template. Copy to `.env` for local dev; set these in Render for prod.
# NEVER commit the real .env (it's gitignored).

# ---- Deployment ----
# Empty = local SQLite. In production: your Neon/Render Postgres URL.
DATABASE_URL=
# Comma-separated frontend origins allowed by CORS (your Vercel URL/domain).
FRONTEND_ORIGINS=http://localhost:5173
# "production" on Render (disables the local dev-login).
ENVIRONMENT=development

# ---- Auth ----
# Google OAuth Web client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Long random secret for signing app JWTs:  openssl rand -hex 32
JWT_SECRET=
# Your Google email — inherits the pre-existing posts on first login.
OWNER_EMAIL=
# Per-user generation cap per rolling hour (optional; default 60).
# RATE_LIMIT_PER_HOUR=60

# ---- AI generation: Cloudflare Workers AI (free) ----
# Get these at https://dash.cloudflare.com -> AI -> Workers AI -> "Use REST API".
CAPTION_PROVIDER=cloudflare
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_JSON_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- Media storage: Cloudinary (free, no card) ----
# Dashboard -> API Environment variable:  cloudinary://key:secret@cloud_name
CLOUDINARY_URL=
